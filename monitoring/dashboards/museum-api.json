{
  "id": null,
  "uid": "museum-api",
  "title": "Museum API",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests per second",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (endpoint) (rate(http_requests_total[1m]))", "legendFormat": "{{endpoint}}" }]
    },
    {
      "type": "timeseries",
      "title": "p95 response time (s)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(http_request_duration_seconds_bucket[1m])))", "legendFormat": "{{endpoint}}" }]
    },
    {
      "type": "timeseries",
      "title": "Errors (4xx / 5xx)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (status) (rate(http_requests_total{status=~\"4..|5..\"}[1m]))", "legendFormat": "{{status}}" }]
    },
    {
      "type": "bargauge",
      "title": "Visits per museum",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (museum) (museum_visits_total)", "legendFormat": "{{museum}}" }]
    }
  ]
}